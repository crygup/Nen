{
  "name": "nen",
  "version": "0.1.117",
  "private": true,
  "description": "Nen desktop anime player",
  "author": "may-be.gay",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "test:e2e:watch": "node scripts/e2e-watch.mjs",
    "start": "electron .",
    "setup:media": "node scripts/setup-media.mjs",
    "package": "npm run build && electron-builder --dir",
    "release": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "semver": "^7.8.5",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/semver": "^7.8.0",
    "@types/webtorrent": "^0.110.0",
    "7zip-bin": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0",
    "resedit": "^1.7.2",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "build": {
    "appId": "app.nen.desktop",
    "productName": "Nen",
    "directories": {
      "output": "test-builds"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "node_modules/**/*.node"
    ],
    "extraResources": [
      {
        "from": "vendor/mpv",
        "to": "mpv",
        "filter": [
          "nen-player.exe",
          "doc/**/*",
          "SOURCE.json"
        ]
      },
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/n.ico"
    },
    "npmRebuild": false,
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Nen-Setup-${version}.${ext}"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
