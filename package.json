{
  "name": "nen-projects",
  "private": true,
  "scripts": {
    "dev": "npm --prefix app run dev --",
    "build": "npm --prefix app run build --",
    "start": "npm --prefix app run start --",
    "setup:media": "npm --prefix app run setup:media --",
    "package": "npm --prefix app run package --",
    "release": "npm --prefix app run release --",
    "dev:browser": "npm --prefix nen-browser run dev",
    "build:browser": "npm --prefix nen-browser run build && npm --prefix nen-browser run build:server",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
